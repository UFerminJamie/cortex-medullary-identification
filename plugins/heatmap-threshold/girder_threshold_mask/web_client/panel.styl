.h-threshold-analysis-content
  padding 8px

  label
    display block
    margin 8px 0 4px

  select, input[type=range]
    width 100%

  .h-heatmap-reset, .h-mask-save
    margin-top 6px

  .h-mask-status
    margin-top 6px
    font-size 12px

  .h-threshold-analysis-note
    font-size 12px
    margin 4px 0

  .h-heatmap-threshold-legend
    display flex
    justify-content space-between
    margin-top 5px
    font-size 12px

  .h-threshold-red
    color #f00

  .h-threshold-blue
    color #00f

.h-threshold-close
  cursor pointer
